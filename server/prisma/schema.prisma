generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "vault"]
}

// ----------------------------------------------------
// PUBLIC SCHEMA ENUMS & MODELS
// ----------------------------------------------------

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
  SECURITY
  @@schema("public")
}

enum UserStatus {
  PENDING_VERIFY
  ACTIVE
  SUSPENDED
  @@schema("public")
}

enum ComplaintMode {
  CONFIDENTIAL
  ULTRA_ANON
  @@schema("public")
}

enum ComplaintStatus {
  SUBMITTED
  FLAGGED_REVIEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  NEEDS_INFO
  ESCALATED
  RESOLVED
  REOPENED
  REJECTED
  CLOSED
  @@schema("public")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  @@schema("public")
}

enum RestrictedQueue {
  NONE
  ICC
  ANTI_RAGGING
  @@schema("public")
}

enum Outcome {
  VALID
  PARTIAL
  DUPLICATE
  UNVERIFIABLE
  SPAM
  MALICIOUS
  @@schema("public")
}

enum TargetEntityType {
  DEPARTMENT
  PLACE
  ROLE_LABEL
  @@schema("public")
}

enum AlertType {
  CRITICAL
  PATTERN
  RECURRENCE
  SLA_BREACH
  SPAM_BURST
  @@schema("public")
}

enum AlertStatus {
  OPEN
  ACK
  DONE
  @@schema("public")
}

enum SosStatus {
  TRIGGERED
  DISPATCHED
  ACK
  RESPONDING
  RESOLVED
  FALSE_ALARM
  @@schema("public")
}

model User {
  id             String         @id @default(uuid())
  username       String         @unique
  passwordHash   String         @map("password_hash")
  role           Role           @default(STUDENT)
  collegeEmail   String         @unique @map("college_email")
  rosterId       String?        @unique @map("roster_id")
  status         UserStatus     @default(PENDING_VERIFY)
  department     String?
  phone          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  rosterEntry    CollegeRoster? @relation(fields: [rosterId], references: [id])
  verifications  VerificationRequest[]
  assignedCases  Complaint[]    @relation("AssignedAdmin")
  notes          InternalNote[]
  sosEvents      SosEvent[]
  assistantSessions AssistantSession[]
  auditActions   AuditLog[]

  @@map("users")
  @@schema("public")
}

model CollegeRoster {
  id           String   @id @default(uuid())
  enrollmentNo String   @unique @map("enrollment_no")
  fullName     String   @map("full_name")
  collegeEmail String   @unique @map("college_email")
  role         Role
  department   String
  claimed      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?

  @@map("college_roster")
  @@schema("public")
}

model VerificationRequest {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  method         String    // ROSTER_OTP, ID_CARD
  otpHash        String?   @map("otp_hash")
  otpExpires     DateTime? @map("otp_expires")
  idCardFileKey  String?   @map("id_card_file_key")
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy     String?   @map("reviewed_by")
  rejectionReason String?  @map("rejection_reason")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id])

  @@map("verification_requests")
  @@schema("public")
}

model Complaint {
  id               String          @id @default(uuid())
  trackingKeyHash  String          @unique @map("tracking_key_hash")
  categoryId       String          @map("category_id")
  title            String
  description      String
  locationId       String          @map("location_id")
  incidentAt       DateTime        @map("incident_at")
  mode             ComplaintMode   @default(CONFIDENTIAL)
  status           ComplaintStatus @default(SUBMITTED)
  priority         Priority        @default(MEDIUM)
  pseudonym        String          // e.g., "Complainant #A7F3"
  assignedTo       String?         @map("assigned_to")
  clusterId        String?         @map("cluster_id")
  targetEntityId   String?         @map("target_entity_id")
  restrictedQueue  RestrictedQueue @default(NONE) @map("restricted_queue")
  satisfactionRating Int?          @map("satisfaction_rating")
  outcome          Outcome?
  outcomeReason    String?         @map("outcome_reason")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  resolvedAt       DateTime?       @map("resolved_at")

  // ZERO user foreign keys here. Anonymity is guaranteed by schema.
  category         Category        @relation(fields: [categoryId], references: [id])
  location         Location        @relation(fields: [locationId], references: [id])
  assignedAdmin    User?           @relation("AssignedAdmin", fields: [assignedTo], references: [id])
  cluster          ComplaintCluster? @relation(fields: [clusterId], references: [id])
  targetEntity     TargetEntity?   @relation(fields: [targetEntityId], references: [id])
  events           ComplaintEvent[]
  messages         ComplaintMessage[]
  notes            InternalNote[]
  attachments      Attachment[]
  aiAnalyses       AiAnalysis[]
  riskAlerts       RiskAlert[]
  breakGlassRequests BreakGlassRequest[]

  @@map("complaints")
  @@schema("public")
}

model ComplaintEvent {
  id          String   @id @default(uuid())
  complaintId String   @map("complaint_id")
  type        String   // SUBMITTED, AI_SCREENED, ASSIGNED, STATUS_CHANGE, MESSAGE_SENT, ESCALATED, RESOLVED
  actorRole   Role?    @map("actor_role")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_events")
  @@schema("public")
}

model ComplaintMessage {
  id          String   @id @default(uuid())
  complaintId String   @map("complaint_id")
  sender      String   // COMPLAINANT, ADMIN
  adminId     String?  @map("admin_id")
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@map("complaint_messages")
  @@schema("public")
}

model InternalNote {
  id          String   @id @default(uuid())
  complaintId String   @map("complaint_id")
  adminId     String   @map("admin_id")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  admin       User      @relation(fields: [adminId], references: [id])

  @@map("internal_notes")
  @@schema("public")
}

model Attachment {
  id          String   @id @default(uuid())
  complaintId String   @map("complaint_id")
  messageId   String?  @map("message_id")
  fileKey     String   @map("file_key")
  mime        String
  size        Int
  sanitized   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  message     ComplaintMessage? @relation(fields: [messageId], references: [id])

  @@map("attachments")
  @@schema("public")
}

model Category {
  id              String          @id @default(uuid())
  name            String          @unique
  severityWeight  Int             @default(10) @map("severity_weight")
  routesToQueue   RestrictedQueue @default(NONE) @map("routes_to_queue")
  isSafety        Boolean         @default(false) @map("is_safety")
  complaints      Complaint[]

  @@map("categories")
  @@schema("public")
}

model Location {
  id         String      @id @default(uuid())
  name       String      @unique
  lat        Float
  lng        Float
  complaints Complaint[]

  @@map("locations")
  @@schema("public")
}

model TargetEntity {
  id         String           @id @default(uuid())
  type       TargetEntityType
  label      String           @unique
  complaints Complaint[]
  riskAlerts RiskAlert[]

  @@map("target_entities")
  @@schema("public")
}

model ComplaintCluster {
  id           String      @id @default(uuid())
  size         Int         @default(1)
  firstSeen    DateTime    @default(now()) @map("first_seen")
  lastSeen     DateTime    @default(now()) @map("last_seen")
  complaints   Complaint[]
  riskAlerts   RiskAlert[]

  @@map("complaint_clusters")
  @@schema("public")
}

model AiAnalysis {
  id                String    @id @default(uuid())
  complaintId       String    @map("complaint_id")
  model             String
  promptVersion     String    @map("prompt_version")
  summary           String
  suggestedCategory String    @map("suggested_category")
  severityScore     Int       @map("severity_score")
  priority          Priority
  spamProbability   Float     @map("spam_probability")
  anomalyFlags      Json      @default("[]") @map("anomaly_flags")
  reasoning         String
  createdAt         DateTime  @default(now()) @map("created_at")
  overriddenBy      String?   @map("overridden_by")

  complaint         Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
  @@schema("public")
}

model RiskAlert {
  id                 String       @id @default(uuid())
  type               AlertType
  complaintId        String?      @map("complaint_id")
  clusterId          String?      @map("cluster_id")
  targetEntityId     String?      @map("target_entity_id")
  message            String
  recommendedActions Json         @default("[]") @map("recommended_actions")
  status             AlertStatus  @default(OPEN)
  createdAt          DateTime     @default(now()) @map("created_at")

  complaint          Complaint?   @relation(fields: [complaintId], references: [id])
  cluster            ComplaintCluster? @relation(fields: [clusterId], references: [id])
  targetEntity       TargetEntity? @relation(fields: [targetEntityId], references: [id])

  @@map("risk_alerts")
  @@schema("public")
}

model RuleDocument {
  id        String        @id @default(uuid())
  title     String
  category  String
  bodyMd    String        @map("body_md")
  fileKey   String?       @map("file_key")
  version   Int           @default(1)
  updatedBy String        @map("updated_by")
  updatedAt DateTime      @updatedAt @map("updated_at")
  versions  RuleVersion[]
  chunks    RuleChunk[]

  @@map("rule_documents")
  @@schema("public")
}

model RuleVersion {
  id         String       @id @default(uuid())
  ruleId     String       @map("rule_id")
  version    Int
  bodyMd     String       @map("body_md")
  changedBy  String       @map("changed_by")
  changeNote String?      @map("change_note")
  createdAt  DateTime     @default(now()) @map("created_at")

  rule       RuleDocument @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("rule_versions")
  @@schema("public")
}

model RuleChunk {
  id           String       @id @default(uuid())
  ruleId       String       @map("rule_id")
  version      Int
  chunkText    String       @map("chunk_text")
  sectionLabel String       @map("section_label")
  createdAt    DateTime     @default(now()) @map("created_at")

  rule         RuleDocument @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("rule_chunks")
  @@schema("public")
}

model AssistantSession {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  title     String             @default("New Session")
  createdAt DateTime           @default(now()) @map("created_at")
  messages  AssistantMessage[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assistant_sessions")
  @@schema("public")
}

model AssistantMessage {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  role      String           // user, assistant
  content   String
  citations Json             @default("[]")
  createdAt DateTime         @default(now()) @map("created_at")

  session   AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("assistant_messages")
  @@schema("public")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  channel   String    // IN_APP, EMAIL
  type      String
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
  @@schema("public")
}

model SosEvent {
  id           String               @id @default(uuid())
  userId       String               @map("user_id") // Strictly non-anonymous
  lat          Float
  lng          Float
  accuracy     Float?
  status       SosStatus            @default(TRIGGERED)
  dispatchedTo Json                 @default("[]") @map("dispatched_to")
  createdAt    DateTime             @default(now()) @map("created_at")
  pings        SosLocationPing[]
  user         User                 @relation(fields: [userId], references: [id])

  @@map("sos_events")
  @@schema("public")
}

model SosLocationPing {
  id        String   @id @default(uuid())
  sosId     String   @map("sos_id")
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at")

  sosEvent  SosEvent @relation(fields: [sosId], references: [id], onDelete: Cascade)

  @@map("sos_location_pings")
  @@schema("public")
}

model PoliceStation {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  lat       Float
  lng       Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("police_stations")
  @@schema("public")
}

model SlaPolicy {
  id                 String   @id @default(uuid())
  priority           Priority @unique
  firstResponseHours Int      @map("first_response_hours")
  resolutionHours    Int      @map("resolution_hours")

  @@map("sla_policies")
  @@schema("public")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  actor     User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
  @@schema("public")
}

model BreakGlassRequest {
  id          String    @id @default(uuid())
  complaintId String    @map("complaint_id")
  requestedBy String    @map("requested_by")
  reason      String
  approverId  String?   @map("approver_id")
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime  @default(now()) @map("created_at")
  decidedAt   DateTime? @map("decided_at")

  complaint   Complaint @relation(fields: [complaintId], references: [id])

  @@map("break_glass_requests")
  @@schema("public")
}

// ----------------------------------------------------
// VAULT SCHEMA (Separate schema with strict DB-level grant isolation)
// ----------------------------------------------------

model ReporterLink {
  complaintId String   @id @map("complaint_id")
  encUserId   String   @map("enc_user_id") // Encrypted with AES-256-GCM
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reporter_links")
  @@schema("vault")
}

model ReporterScore {
  userId    String   @id @map("user_id")
  score     Int      @default(60) // PRD §7 starting score 60
  tier      String   @default("Normal") // Trusted (>=75), Normal (40-74), Watch (<40)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reporter_scores")
  @@schema("vault")
}

model ScoreEvent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  complaintId String?  @map("complaint_id")
  delta       Int
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("score_events")
  @@schema("vault")
}
